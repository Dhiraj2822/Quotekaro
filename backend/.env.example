# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quotekaro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quotekaro
POSTGRES_PORT=5432

# Cache & Pub/Sub (Redis)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Firebase Auth & Push (FCM)
FIREBASE_PROJECT_ID=quotekaro-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@quotekaro-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Maps & Geolocation (Google Maps Platform)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Object Storage (AWS S3 or Cloudflare R2 for job photos, private KYC documents)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=quotekaro-media
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=auto

# Payment Gateway (Razorpay / Cashfree)
PAYMENT_GATEWAY=razorpay
PAYMENT_KEY_ID=rzp_test_xxxxxxx
PAYMENT_KEY_SECRET=your_razorpay_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_signature_secret

# Business Rules
COMMISSION_RATE_PERCENT=10
PROVIDER_MIN_WALLET_BALANCE_PAISE=10000
